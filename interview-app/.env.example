# TeamMetrics — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teammetrics_dev
DB_USER=app_user
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=teammetrics-exports-dev
# Note: AWS credentials should come from IAM role / instance profile, not env vars

# External services
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
